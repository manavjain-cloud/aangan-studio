# Copy to .env.local (or run `npm run keys:sync` from D:\Vaani Project\API_KEYS.txt). Never commit real values.
# All variables are SERVER-SIDE ONLY. There are intentionally no NEXT_PUBLIC_* variables.

# --- App ---
APP_URL=http://localhost:3000          # public https URL in production (Vaani must reach it)
DEFAULT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info                         # debug | info | warn | error | silent
SESSION_SECRET=                        # 32+ random chars; signs the admin session cookie
ADMIN_EMAILS=                          # optional allowlist, comma separated
CRON_SECRET=                           # Bearer token for /api/jobs/run (Vercel Cron sends it automatically)

# --- Mock mode ---
FORCE_MOCK_INTEGRATIONS=0              # 1 = never call real providers (labelled simulated data)
ALLOW_MOCK_IN_PRODUCTION=0             # 1 = permit simulated adapters when NODE_ENV=production (demos only)

# --- Neon PostgreSQL (unset = local PGlite for development only; production requires it) ---
DATABASE_URL=                          # pooled connection string, NOT the Neon management API key

# --- Vaani Voice ---
VAANI_API_KEY=
VAANI_BASE_URL=https://api.vaanivoice.ai
VAANI_AGENT_ID=
VOICE_TOOL_SECRET=                     # shared secret sent as X-Aangan-Tool-Key by the Vaani custom tools
VAANI_WEBHOOK_TOKEN=                   # appended to the webhook URL as ?token=
VAANI_WEBHOOK_SECRET=                  # only if Vaani signs call webhooks (X-Vaani-Signature)
VAANI_CREDIT_INR=                      # INR per Vaani credit (cost tracking)

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-flash-latest
GEMINI_INPUT_INR_PER_MILLION_TOKENS=
GEMINI_OUTPUT_INR_PER_MILLION_TOKENS=

# --- HubSpot (Private App token) ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CREATE_DEALS=0                 # 1 = also create a deal for qualified leads
HUBSPOT_DEAL_PIPELINE=
HUBSPOT_DEAL_STAGE_QUALIFIED=
HUBSPOT_DEAL_STAGE_BOOKED=

# --- Scheduling provider: Calendly (PAID plan required for booking via API) or Cal.com (free API key) ---
CALENDAR_PROVIDER=                     # calendly | calcom (auto: calcom if only CALCOM_API_KEY is set)
CALCOM_API_KEY=                        # Cal.com Settings -> Security -> API keys
# Calendly:
CALENDLY_ACCESS_TOKEN=
CALENDLY_DEFAULT_EVENT_TYPE_URI=       # fallback single event type if no designers are configured
CALENDLY_LOCATION_TEXT=                # used when the event type has a physical/custom location

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=                            # e.g. Aangan Studio <desk@your-verified-domain>
EMAIL_TEST_RECIPIENT=                  # pilot: redirect ALL email here
FRONT_DESK_EMAIL=
SENIOR_ESCALATION_EMAIL=
OPS_ALERT_EMAIL=

# --- Data retention ---
TRANSCRIPT_RETENTION_DAYS=90
