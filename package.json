{
  "name": "aangan-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/db-seed.ts",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/admin-create.ts",
    "vaani:tools": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/print-vaani-tools.ts",
    "simulate:call": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/simulate-call.ts",
    "keys:sync": "tsx scripts/sync-keys.ts",
    "check:integrations": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/check-integrations.ts",
    "hubspot:setup": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/hubspot-setup.ts",
    "team:add": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/team-add.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.28.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "livekit-client": "2.9.9",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
